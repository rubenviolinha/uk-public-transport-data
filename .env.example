# Obtain this from the Department for Transport Bus Open Data Service.
# Do not commit a real key.
BODS_API_KEY=replace_me

# Polling interval for the backend cache, in seconds.
LIVE_DATA_POLL_SECONDS=20

# National Rail Darwin Push Port — live snapshot and incremental updates.
DARWIN_SFTP_HOST=replace_me
DARWIN_SFTP_PORT=2222
DARWIN_SFTP_USERNAME=replace_me
DARWIN_SFTP_PASSWORD=replace_me
DARWIN_SFTP_SNAPSHOT_DIRECTORY=snapshot
DARWIN_MESSAGING_HOST=replace_me
DARWIN_STOMP_PORT=61618
DARWIN_TOPIC_USERNAME=replace_me
DARWIN_TOPIC_PASSWORD=replace_me
DARWIN_LIVE_FEED_TOPIC=replace_me
DARWIN_STATION=RUGBY
DARWIN_SNAPSHOT_INTERVAL_SECONDS=60
DARWIN_TOPIC_TEST_SECONDS=60
