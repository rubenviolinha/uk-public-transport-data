# Obtain this from the Department for Transport Bus Open Data Service.
# Do not commit a real key.
BODS_API_KEY=replace_me

# Polling interval for the backend cache, in seconds.
LIVE_DATA_POLL_SECONDS=20

# Bus departures endpoint consumed by display:poll. It may return the normalised
# JSON shape below or a raw SIRI-VM XML response.
# JSON example: { "departures": [{ "route": "2", "stopId": "4200F057700", "direction": "Northbound", "aimedDepartureTime": "07:13", "predictedDepartureTime": "07:16" }] }.
BODS_DEPARTURES_URL=replace_me
# Optional ATCO code used when parsing a raw SIRI-VM response.
BODS_STOP_ID=4200F057700
DISPLAY_DATA_FILE=data/cache/display.json
# Required for configuration/provisioning when NODE_ENV=production.
DISPLAY_ADMIN_TOKEN=replace_me
DARWIN_BOARD_FILE=data/darwin/rugby-departures.json
VALIDATION_INTERVAL_SECONDS=30
VALIDATION_DURATION_SECONDS=0
VALIDATION_REPORT_FILE=data/validation/display-samples.jsonl

# National Rail Darwin Push Port — live snapshot and incremental updates.
DARWIN_SFTP_HOST=replace_me
DARWIN_SFTP_PORT=2222
DARWIN_SFTP_USERNAME=replace_me
DARWIN_SFTP_PASSWORD=replace_me
DARWIN_SFTP_SNAPSHOT_DIRECTORY=snapshot
DARWIN_MESSAGING_HOST=replace_me
DARWIN_STOMP_PORT=61618
DARWIN_TOPIC_USERNAME=replace_me
DARWIN_TOPIC_PASSWORD=replace_me
DARWIN_LIVE_FEED_TOPIC=replace_me
DARWIN_STATION=RUGBY
DARWIN_SNAPSHOT_INTERVAL_SECONDS=60
DARWIN_TOPIC_TEST_SECONDS=60
